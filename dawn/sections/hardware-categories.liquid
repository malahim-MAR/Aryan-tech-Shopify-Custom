{{ 'hardware-store.css' | asset_url | stylesheet_tag }}
<section class="tech-wrap tech-departments" aria-labelledby="departments-{{ section.id }}">
  <div class="tech-department-heading">
    <h2 id="departments-{{ section.id }}">{{ section.settings.title | escape }}</h2>
    <a href="{{ routes.collections_url }}">All categories <span aria-hidden="true">→</span></a>
  </div>
  <div class="tech-tiles">
    {% for block in section.blocks %}
      {% liquid
        assign department = block.settings.collection
        assign label = department.title | default: block.settings.title
        assign photo = block.settings.image | default: department.featured_image
        assign query = block.settings.query | default: label | url_encode
        assign fallback = routes.search_url | append: '?type=product&q=' | append: query
      %}
      <a class="tech-tile" href="{{ department.url | default: fallback }}" {{ block.shopify_attributes }}>
        <strong>{{ label | escape }}</strong>
        {% if department %}<small>{{ department.all_products_count }} products</small>{% endif %}
        <span class="tech-link-arrow" aria-hidden="true">↗</span>
        {% if photo %}
          {{ photo | image_url: width: 760 | image_tag: widths: '240, 400, 600, 760', sizes: '(max-width: 749px) 50vw, 30vw', loading: 'lazy', alt: '' }}
        {% else %}
          <img src="{{ block.settings.art | asset_url }}" width="600" height="440" loading="lazy" alt="">
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name":"Hardware categories",
  "settings":[{"type":"text","id":"title","label":"Heading","default":"Start with what you need."}],
  "blocks":[{"type":"department","name":"Category","settings":[
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"image_picker","id":"image","label":"Image override"},
    {"type":"text","id":"title","label":"Fallback category","default":"Graphics cards"},
    {"type":"text","id":"query","label":"Fallback search term"},
    {"type":"select","id":"art","label":"Built-in artwork","default":"tech-graphics-cards.webp","options":[
      {"value":"tech-graphics-cards.webp","label":"Graphics card"},{"value":"tech-monitors.webp","label":"Monitor"},
      {"value":"tech-laptops.webp","label":"Laptop"},{"value":"tech-cases.webp","label":"Case"},
      {"value":"tech-keyboards.webp","label":"Keyboard"},{"value":"tech-mice.webp","label":"Mouse"},
      {"value":"tech-headphones.webp","label":"Headphones"},{"value":"tech-chairs.webp","label":"Gaming chair"}
    ]}
  ]}],
  "presets":[{"name":"Hardware categories","blocks":[{"type":"department"}]}]
}
{% endschema %}
