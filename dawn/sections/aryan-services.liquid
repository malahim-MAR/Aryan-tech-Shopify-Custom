<section class="at-service at-shell">
  <h2>{{ section.settings.heading | escape }}</h2>
  <div class="at-service__grid">
    {% for block in section.blocks %}
      {% liquid
        case block.type
          when 'shipping'
            assign destination = shop.shipping_policy.url
            assign icon = 'icon-truck.svg'
          when 'returns'
            assign destination = shop.refund_policy.url
            assign icon = 'icon-return.svg'
          when 'support'
            assign destination = pages['contact'].url
            assign icon = 'icon-chat-bubble.svg'
        endcase
        assign destination = block.settings.link | default: destination
      %}
      {% if destination %}
        <a href="{{ destination }}" {{ block.shopify_attributes }}>
          <span class="at-service__icon">{{ icon | inline_asset_content }}</span>
          <strong>{{ block.settings.title | escape }}</strong>
          <span>{{ block.settings.caption | escape }} <i aria-hidden="true">→</i></span>
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% schema %}
{"name":"Store services","settings":[{"type":"text","id":"heading","label":"Heading","default":"Shopping with Aryan Tech"}],"blocks":[
{"type":"shipping","name":"Shipping","limit":1,"settings":[{"type":"text","id":"title","label":"Title","default":"Delivery"},{"type":"text","id":"caption","label":"Link text","default":"Shipping information"},{"type":"url","id":"link","label":"Link override"}]},
{"type":"returns","name":"Returns","limit":1,"settings":[{"type":"text","id":"title","label":"Title","default":"Returns & refunds"},{"type":"text","id":"caption","label":"Link text","default":"Read our policy"},{"type":"url","id":"link","label":"Link override"}]},
{"type":"support","name":"Support","limit":1,"settings":[{"type":"text","id":"title","label":"Title","default":"Product support"},{"type":"text","id":"caption","label":"Link text","default":"Contact Aryan Tech"},{"type":"url","id":"link","label":"Link override"}]}],"presets":[{"name":"Store services","blocks":[{"type":"shipping"},{"type":"returns"},{"type":"support"}]}]}
{% endschema %}
