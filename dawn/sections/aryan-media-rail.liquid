<section class="at-film at-shell" aria-labelledby="film-{{ section.id }}">
  <header><h2 id="film-{{ section.id }}">{{ section.settings.heading | escape }}</h2></header>
  <ul role="list" class="at-film__track" tabindex="0" aria-label="{{ section.settings.heading | escape }}">
    {% for block in section.blocks %}
      {% liquid
        assign item = block.settings.product
        assign clip = block.settings.video
        if clip == blank and item != blank
          assign clip = item.media | where: 'media_type', 'video' | first
        endif
        assign picture = block.settings.image | default: item.featured_image
        assign caption = block.settings.caption | default: item.title
        assign destination = block.settings.link | default: item.url | default: routes.all_products_collection_url
      %}
      <li {{ block.shopify_attributes }}>
        {% if clip %}
          {{ clip | video_tag: controls: true, preload: 'none', image_size: '540x', playsinline: true }}
        {% elsif picture %}
          <a class="at-film__photo" href="{{ destination }}" aria-label="{{ caption | escape }}">
            {{ picture | image_url: width: 680 | image_tag: widths: '300, 460, 680', sizes: '(min-width: 990px) 20vw, 68vw', loading: 'lazy', alt: '' }}
          </a>
        {% else %}
          <a class="at-film__photo" href="{{ destination }}" aria-label="{{ caption | escape }}"><img src="{{ block.settings.art | asset_url }}" width="320" height="540" alt="" loading="lazy"></a>
        {% endif %}
        <a class="at-film__caption{% if clip %} at-film__caption--video{% endif %}" href="{{ destination }}">
          {% if block.settings.avatar %}{{ block.settings.avatar | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}{% endif %}
          <span><strong>{{ caption | escape }}</strong><small>{{ block.settings.byline | default: item.vendor | escape }}</small></span>
        </a>
      </li>
    {% endfor %}
  </ul>
</section>
{% schema %}
{"name":"Portrait media rail","settings":[{"type":"text","id":"heading","label":"Heading","default":"Inside the setup"}],"blocks":[{"type":"story","name":"Photo or video","settings":[{"type":"product","id":"product","label":"Featured product"},{"type":"video","id":"video","label":"Shopify video"},{"type":"image_picker","id":"image","label":"Photo"},{"type":"text","id":"caption","label":"Caption"},{"type":"text","id":"byline","label":"Creator or category"},{"type":"image_picker","id":"avatar","label":"Profile photo"},{"type":"url","id":"link","label":"Destination override"},{"type":"select","id":"art","label":"Fallback image","default":"aryan-keyboard-editorial.webp","options":[{"value":"aryan-keyboard-editorial.webp","label":"Keyboard editorial"},{"value":"aryan-mouse-editorial.webp","label":"Mouse editorial"},{"value":"aryan-x-raypad.webp","label":"X-Raypad"},{"value":"aryan-key-caps.webp","label":"Keycaps"},{"value":"aryan-keyboards.webp","label":"Keyboards"}]}]}],"presets":[{"name":"Portrait media rail"}]}
{% endschema %}
