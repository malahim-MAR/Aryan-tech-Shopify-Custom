<section class="at-shell at-editorials" aria-label="Featured collections">
  {% for block in section.blocks %}
    <a class="at-editorial" href="{{ block.settings.collection.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
      {% if block.settings.image %}
        {{ block.settings.image | image_url: width: 1400 | image_tag: widths: '450, 750, 1000, 1400', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: '' }}
      {% else %}
        <img src="{{ block.settings.art | asset_url }}" width="1000" height="625" alt="" loading="lazy">
      {% endif %}
      <span><strong>{{ block.settings.heading | escape }}</strong><em>{{ block.settings.button | escape }} →</em></span>
    </a>
  {% endfor %}
</section>
{% schema %}
{"name":"Campaign grid","max_blocks":4,"blocks":[{"type":"campaign","name":"Campaign","settings":[{"type":"text","id":"heading","label":"Heading","default":"Mechanical keyboards"},{"type":"text","id":"button","label":"Link label","default":"Shop now"},{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Image override"},{"type":"select","id":"art","label":"Built-in photo","default":"aryan-keyboard-editorial.webp","options":[{"value":"aryan-keyboard-editorial.webp","label":"Womier keyboard"},{"value":"aryan-mouse-editorial.webp","label":"ATK mouse"}]}]}],"presets":[{"name":"Campaign grid","blocks":[{"type":"campaign"}]}]}
{% endschema %}
