{%- liquid
  assign source = section.settings.collection | default: collections.all
  assign deal_count = 0
-%}
{%- capture deal_cards -%}
  {%- for item in source.products limit: 50 -%}
    {%- assign deal_variant = nil -%}
    {%- for option in item.variants -%}
      {%- if option.available and option.compare_at_price > option.price -%}
        {%- assign deal_variant = option -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if deal_variant == nil -%}{%- continue -%}{%- endif -%}
    {%- liquid
      assign deal_count = deal_count | plus: 1
      assign saving = deal_variant.compare_at_price | minus: deal_variant.price
      assign percent = saving | times: 100.0 | divided_by: deal_variant.compare_at_price | round
      assign photo = deal_variant.featured_image | default: item.featured_image
      assign image_width = 200
      assign image_sizes = '80px'
      if deal_count == 1
        assign image_width = 900
        assign image_sizes = '(min-width: 750px) 40vw, 100vw'
      endif
    -%}
    <article class="tech-deal{% if deal_count == 1 %} tech-deal--feature{% endif %}">
      <a class="tech-deal__media" href="{{ deal_variant.url }}" aria-label="{{ item.title | escape }}">
        {%- if photo -%}
          {{ photo | image_url: width: image_width | image_tag: loading: 'lazy', sizes: image_sizes, alt: '' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        {%- if deal_count == 1 -%}
          <span class="tech-deal__stamp"><strong>−{{ percent }}%</strong>Save {{ saving | money }}</span>
        {%- endif -%}
      </a>
      <div class="tech-deal__body">
        {%- if deal_count == 1 -%}<small>{{ item.vendor | escape }}</small>{%- endif -%}
        <h3><a href="{{ deal_variant.url }}">{{ item.title | escape }}</a></h3>
        <p><strong>{{ deal_variant.price | money }}</strong> <s>{{ deal_variant.compare_at_price | money }}</s></p>
        {%- if deal_count == 1 -%}<a class="tech-deal__shop" href="{{ deal_variant.url }}">View deal <span aria-hidden="true">→</span></a>{%- endif -%}
      </div>
      {%- unless deal_count == 1 -%}<span class="tech-deal__saving">−{{ percent }}%</span>{%- endunless -%}
    </article>
    {%- if deal_count >= 7 -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if deal_count > 0 or request.design_mode -%}
  {{ 'tech-catalog.css' | asset_url | stylesheet_tag }}
  <section class="tech-catalog page-width" aria-labelledby="Deals-{{ section.id }}">
    <div class="tech-catalog__head">
      <div>
        <h2 id="Deals-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <p>Hardware with a lower price today.</p>
      </div>
      {%- if section.settings.collection != blank -%}<a href="{{ source.url }}">Browse collection <span aria-hidden="true">→</span></a>{%- endif -%}
    </div>
    {%- if deal_count > 0 -%}
      <div class="tech-deals-board">{{ deal_cards }}</div>
    {%- else -%}
      <p>Choose a collection with available products whose compare-at price exceeds their selling price.</p>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Hardware deals",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Price drops, while stock lasts."},
    {"type": "collection", "id": "collection", "label": "Deals collection", "info": "Displays up to seven available deals from the first 50 products."}
  ],
  "presets": [{"name": "Hardware deals"}]
}
{% endschema %}
