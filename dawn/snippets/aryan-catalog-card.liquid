{% liquid
  assign variant = item.selected_or_first_available_variant
  assign photo = variant.featured_image | default: item.featured_image
  assign rating = item.metafields.reviews.rating.value
%}
<article class="at-card">
  <a class="at-card__photo" href="{{ item.url }}" aria-label="{{ item.title | escape }}">
    {% if photo %}
      {{ photo | image_url: width: 720 | image_tag: widths: '180, 300, 420, 560, 720', sizes: '(max-width: 749px) 48vw, 24vw', loading: loading, alt: item.title }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag }}
    {% endif %}
    {% if item.type != blank %}<span class="at-tag">{{ item.type | escape }}</span>{% endif %}
  </a>
  <div class="at-card__body">
    {% if variant.compare_at_price > variant.price %}
      <span class="at-savings">{{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round }}% OFF</span>
    {% endif %}
    <h3><a href="{{ item.url }}">{{ item.title | escape }}</a></h3>
    {% if item.vendor != blank %}<span class="at-maker">{{ item.vendor | escape }}</span>{% endif %}
    {% for option in item.options_with_values %}
      {% assign option_name = option.name | downcase %}
      {% if option_name == 'color' or option_name == 'colour' %}
        <div class="at-colors">
          {% for value in option.values limit: 3 %}
            {% assign color_variant = value.variant %}
            {% if color_variant %}
              <a href="{{ color_variant.url }}" title="{{ value | escape }}" aria-label="{{ item.title | escape }} — {{ value | escape }}">
                {% if value.swatch.color %}
                  <i style="background-color:rgb({{ value.swatch.color.rgb }})"></i>
                {% elsif color_variant.featured_image %}
                  {{ color_variant.featured_image | image_url: width: 48 | image_tag: loading: 'lazy', alt: '' }}
                {% else %}
                  {{ value | escape }}
                {% endif %}
              </a>
            {% endif %}
          {% endfor %}
          {% if option.values.size > 3 %}<small>+{{ option.values.size | minus: 3 }}</small>{% endif %}
        </div>
        {% break %}
      {% endif %}
    {% endfor %}
    {% if rating %}<span class="at-rating">★ {{ rating.rating }} / {{ rating.scale_max }}</span>{% endif %}
    <div class="at-card__buy">
      <p>{% if variant.compare_at_price > variant.price %}<s>{{ variant.compare_at_price | money }}</s>{% endif %} <strong>{{ variant.price | money }}</strong></p>
      <a href="{{ item.url }}">{% if item.available %}Buy now{% else %}View product{% endif %}</a>
    </div>
  </div>
</article>
