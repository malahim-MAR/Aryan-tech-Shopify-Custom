{% doc %}
  Renders the hardware shopping directory in the desktop menu or mobile drawer.
  @param {string} [placement] - Set to drawer for compact mobile spacing.
{% enddoc %}
{% liquid
  assign departments = 'PC Components|Laptops & PCs|Monitors & Displays|Peripherals|Gaming Gear|Networking & More' | split: '|'
  assign groups = 'Graphics Cards,Processors,Motherboards,Memory,Storage,Power Supplies,PC Cases|Gaming Laptops,MacBook,Mini PCs,Desktop PCs|Gaming Monitors,Monitor Arms,Projectors|Keyboards,Gaming Mice,Headphones,Speakers,Webcams|Gaming Chairs,Controllers,Consoles|Routers,Adapters,Cables,UPS' | split: '|'
%}
<div class="tech-directory{% if placement == 'drawer' %} tech-directory--drawer{% endif %}">
  {% for department in departments %}
    {% assign terms = groups[forloop.index0] | split: ',' %}
    <div>
      <strong>{{ department | escape }}</strong>
      <ul class="list-unstyled">
        {% for term in terms %}
          {% assign handle = term | handleize %}
          <li><a href="{% if collections[handle] != blank %}{{ collections[handle].url }}{% else %}{{ routes.search_url }}?type=product&amp;q={{ term | url_encode }}{% endif %}">{{ term | escape }}</a></li>
        {% endfor %}
      </ul>
    </div>
  {% endfor %}
  <a class="tech-directory__all" href="{{ routes.all_products_collection_url }}">Shop all products <span aria-hidden="true">→</span></a>
</div>
